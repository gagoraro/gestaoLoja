# Copie para .env (NÃO versionar) ou configure no seu provedor de deploy.
# Preencha com os dados do SEU projeto; nunca commite valores reais.
SPRING_PROFILES_ACTIVE=supabase
# URL do projeto, para validar o login (Project Settings > API)
SUPABASE_URL=https://<ID_DO_PROJETO>.supabase.co
SUPABASE_DB_URL=jdbc:postgresql://<HOST>:5432/postgres?sslmode=require
SUPABASE_DB_USER=<USUARIO>
SUPABASE_DB_PASSWORD=<SENHA>
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOJA_NOME=A Vitoriosa de Angra
